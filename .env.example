NEXT_PUBLIC_SITE_URL=https://theldo.com
# Optional: without a key the chat shows a visitor-friendly offline response.
# Supported providers: gemini, groq, openai. Use a currently available model.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
# Set only to a client IP header your reverse proxy overwrites (never forwards verbatim).
# Otherwise the per-instance limiter shares a 10 requests/minute budget.
CHAT_TRUSTED_IP_HEADER=


NEXT_PUBLIC_GISCUS_REPO=igmrrf/igmrrf
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
