# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Compiled Slidev decks — build artefacts, rebuilt by scripts/build-decks.mjs.
# Only the compiled SPA directories are ignored: the exported PDF next to them
# is committed on purpose, because `slidev export` needs playwright-chromium
# and the deploy build cannot produce it.
/public/decks/*/
decks/*/node_modules/
